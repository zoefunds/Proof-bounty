DATABASE_URL=postgresql://proofbounty:proofbounty_dev_only@localhost:5443/proofbounty
PORT=8080
PROOFBOUNTY_CONTRACT_ADDRESS=0x8A27ead9Db4Aa269eC5b298129270E23e63ADCA2
GENLAYER_RPC_URL=https://studio.genlayer.com/api
INDEXER_POLL_INTERVAL_MS=15000
CORS_ORIGIN=https://proof-bounty.vercel.app
NODE_ENV=development

# Redis-backed rate limiter for outbound GenLayer RPC calls. StudioNet's
# real, empirically-discovered caps are 30/min, 500/hour, and 5,000/day —
# all three are paced here with margin below the real limit. Get a free
# Redis instance at https://upstash.com — use the "rediss://" TLS
# connection string it gives you.
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379
GENLAYER_RPC_RATE_LIMIT_PER_MINUTE=30
GENLAYER_RPC_RATE_LIMIT_PER_HOUR=480
GENLAYER_RPC_RATE_LIMIT_PER_DAY=4800
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_ESCROW_ADDRESS=0xFC271817DA30f1BEf651ef5BacDd1a37127f0976
# Never commit these. Use distinct keys in production.
BASE_RELAYER_PRIVATE_KEY=
BASE_DECISION_SIGNER_PRIVATE_KEY=
GENLAYER_FUNDING_ATTESTOR_PRIVATE_KEY=
BASE_RELAY_INTERVAL_MS=120000
