# Deployed ProofBounty Intelligent Contract address on GenLayer StudioNet.
NEXT_PUBLIC_PROOFBOUNTY_CONTRACT_ADDRESS=0x89322f6fc61872B812E4BE9E647F2154B7f73BE1
NEXT_PUBLIC_BASE_ESCROW_ADDRESS=0xEA3Ee1bD267C343c6C8e7C8C24bcfd401836dC83
NEXT_PUBLIC_BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_DEFAULT_FEE_BPS=250

# GenLayer network selection — studionet | testnetAsimov | testnetBradbury | localnet
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# PROOFBOUNTY backend indexer/API (apps/api, deployed to Fly.io). Powers
# fast search/filter/activity/reputation queries; the app always falls back
# to a direct contract read if this is unreachable.
NEXT_PUBLIC_API_URL=https://proofbounty-usdc-api.fly.dev

# Reown (WalletConnect) project ID — powers multi-wallet connect (injected
# extensions, WalletConnect-paired mobile wallets, Coinbase Wallet).
# Get your own free project ID at https://cloud.reown.com if you fork this.
NEXT_PUBLIC_REOWN_PROJECT_ID=00a166f22ba09aef8f71d5c707ba0cdc
